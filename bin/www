#!/usr/bin/env node

/**
 * Module dependencies.
 */

const path = require('path');
const app = require('../app');
const http = require('http');
const debug = require('debug')('malty:server'); // <<< ADICIONE ESTA LINHA

/**
 * Use o server exportado por app.js se existir (evita listen duplo). Caso contrário, cria um novo.
 */

const server = app.server || http.createServer(app);

/**
 * Get port from environment and store in Express.
 */

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Listen on provided port, on all network interfaces.
 *
 * Evita chamar listen() duas vezes se o server já estiver escutando.
 */
if (server.listening) {
  try {
    const addr = server.address();
    const portInfo = addr && addr.port ? addr.port : '(already listening)';
    console.log(`Server já escutando na porta ${portInfo}`);
  } catch (e) {
    console.log('Server já escutando (endereço indisponível)');
  }
  // garante que handlers de erro/listening existam caso não tenham sido ligados
  server.on('error', onError);
  server.on('listening', onListening);
} else {
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Servidor rodando na porta ' + addr.port);
}

// Função de encerramento limpo
function shutdown() {
  console.log('Recebido sinal de encerramento. Fechando o servidor...');
  server.close(() => {
    console.log('Servidor encerrado.');
    process.exit(0);
  });
}

// =================================================================
// ADICIONADO: Garante que o servidor seja encerrado corretamente com Nodemon
// =================================================================
// SIGTERM é enviado pelo nodemon em reinicializações automáticas
process.on('SIGTERM', shutdown);
// SIGINT é enviado quando você pressiona Ctrl+C no terminal
process.on('SIGINT', shutdown);
