doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Verificação de 2 Fatores'
    link(rel="stylesheet", href="/stylesheets/login.css")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap", rel="stylesheet")
    style.
      .instruction-text { margin-bottom: 20px; color: #555; }
      input#token { text-align: center; font-size: 1.5rem; letter-spacing: 0.5em; }

  body
    .login-container
      .login-box
        header
          h1.logo Service-management
          h2 Verificação de 2 Fatores

        if error
          .alert.alert-danger= error

        p.instruction-text Insira o código de 6 dígitos gerado pelo seu aplicativo autenticador.

        form(action="/admin/mfa-verify", method="POST")
          .form-group
            label(for="token") Código de Verificação
            // Atributos para melhor UX: autocomplete, inputmode, pattern
            input(type="text", id="token", name="token", required, autocomplete="one-time-code", inputmode="numeric", pattern="[0-9]{6}", maxlength="6")
          button(type="submit", class="btn-submit") Verificar
        .links
          a(href="/admin/login") Voltar para o login