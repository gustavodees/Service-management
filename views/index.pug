extends layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow-sm
          .card-body.p-4
            .text-center.mb-4
              h1.h3.mb-3.font-weight-normal Acessar sua Conta
              p Preencha os dados para continuar

            if error
              .alert.alert-danger= error
            if success
              .alert.alert-success= success

            form(action="/login", method="POST")
              .form-group
                label(for="cnpj") CNPJ da Empresa
                input#cnpj.form-control(type="text", name="cnpj", placeholder="00.000.000/0001-00", required)

              .form-group
                label(for="email") Email ou Usuário
                input#email.form-control(type="text", name="email", placeholder="seu.email@empresa.com", required)

              .form-group
                label(for="senha") Senha
                input#senha.form-control(type="password", name="senha", placeholder="Sua senha", required)

              button.btn.btn-lg.btn-primary.btn-block.mt-4(type="submit") Entrar

            .mt-3.text-center
              a(href="/cadastro-empresa") Não tem uma conta? Cadastre sua empresa