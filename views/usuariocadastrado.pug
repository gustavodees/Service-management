extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  style.
    .btn-edit { background-color: #3498db; color: white; }
    .btn-edit:hover { background-color: #2980b9; }

block content
  include header
  .page-container
    .page-header
      div
        h1.page-title Usuários Cadastrados
        p.page-subtitle Gerencie os usuários do sistema.
      a(href="/cadastro", class="btn-primary") + Novo Usuário

    if error
      .alert.alert-danger= error
    if success
      .alert.alert-success= success

    .content-card
      if usuarios && usuarios.length > 0
        table.styled-table
          thead
            tr
              th Nome
              th Email
              th Tipo
              th Ações
          tbody
            each usuario in usuarios
              tr(id=`user-row-${usuario.id}`)
                td= usuario.nome
                td= usuario.email
                td
                  span(class=`user-type ${usuario.tipo}`)= usuario.tipo
                td
                  .action-buttons
                    a.btn-action.btn-edit(href=`/editar-usuario/${usuario.id}`) Editar
                    button.btn-action.btn-delete(onclick=`deletarUsuario(${usuario.id})`) Deletar
      else
        p Nenhum usuário cadastrado ainda.

  script.
    async function deletarUsuario(userId) {
      if (!confirm('Tem certeza que deseja deletar este usuário? Esta ação não pode ser desfeita.')) {
        return;
      }

      try {
        const response = await fetch(`/deletar-usuario/${userId}`, {
          method: 'DELETE',
        });

        const result = await response.json();

        if (result.success) {
          document.getElementById(`user-row-${userId}`).remove();
        } else {
          alert('Erro ao deletar usuário: ' + result.message);
        }
      } catch (error) {
        console.error('Erro na requisição:', error);
        alert('Ocorreu um erro de comunicação com o servidor.');
      }
    }