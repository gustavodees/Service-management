doctype html
html(lang="pt-BR")
  head
    title= title
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel='stylesheet', href='/stylesheets/style.css')
    // Adicionado: Estilo para o overlay de drag-and-drop
    link(rel='stylesheet', href='/stylesheets/drag-drop-fix.css')
    // Adicionado: Estilo para skeleton loaders
    link(rel='stylesheet', href='/stylesheets/skeletons.css')
    // Adicionado: Estilos para as páginas de conexões
    link(rel='stylesheet', href='/stylesheets/connections.css')
    link(rel="icon" href="/favicon.ico" type="image/x-icon")
    block head
  body
    main
      block content

    // Adicionado: Lógica para controlar o overlay de drag-and-drop
    script(src='/javascripts/drag-drop-handler.js')
    script(src="https://code.jquery.com/jquery-3.5.1.slim.min.js")
    script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js")
    script(src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js")
