extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  script(src="/javascripts/dashboard.js" defer)

block content
  include header
  .page-container
    .page-header
      div
        h1.page-title Tabulação de Clientes
        p.page-subtitle Organize e filtre seus atendimentos.
      .exportar-area
        button#btn-export-excel.btn.btn-success(type="button")
          i.fa-solid.fa-file-excel.mr-2
          | Exportar Excel

    .content-card
      .container-tabulacao
        .botoes-status
          button.btn-status.aniversariantes(data-status="aniversariantes") Aniversariantes
          button.btn-status.sem-possibilidade(data-status="sem-possibilidade") Sem possibilidade de saque
          button.btn-status.conversa-inativa(data-status="conversa-inativa") Conversa inativa, sem resposta do cliente
          button.btn-status.mudancas-cadastrais(data-status="mudancas-cadastrais") Mudanças cadastrais
          button.btn-status.negocio-fechado(data-status="negocio-fechado") Negócio fechado
          button.btn-status.sem-interesse(data-status="sem-interesse") Sem interesse na oferta

        // Novo: filtro de mês (aparece apenas quando "Aniversariantes" está ativo)
        .filtro-aniversariantes(style="display:none; margin:10px 0;")
          label(for="mes-aniversariantes" style="margin-right:8px; font-weight:600;") Filtrar por mês:
          input#mes-aniversariantes(type="month" style="padding:6px; border:1px solid #ccc; border-radius:6px;")

        .tabulacao-lista(data-status="aniversariantes")
        .tabulacao-lista(data-status="sem-possibilidade")
        .tabulacao-lista(data-status="conversa-inativa")
        .tabulacao-lista(data-status="mudancas-cadastrais")
        .tabulacao-lista(data-status="negocio-fechado")
        .tabulacao-lista(data-status="sem-interesse")
  
  // Biblioteca para gerar XLSX
  script(src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js")
  script(src="/javascripts/tabulacao.js")
