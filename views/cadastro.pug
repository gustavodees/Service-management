extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")

block content
  include header
  .page-container
    .page-header
      div
        h1.page-title Cadastro de Usuário
        p.page-subtitle Preencha os dados para criar um novo acesso.

    //- Centraliza o card de conteúdo
    .content-card(style="max-width: 600px; margin: 0 auto;")
      if error
        .alert.alert-danger= error
      if success
        .alert.alert-success= success

      form(method="POST", action="/cadastro")
        .form-group
          label(for="nome") Nome Completo
          input.form-control(type="text", id="nome", name="nome", placeholder="Ex: João da Silva", required)

        .form-group
          label(for="email") Email
          input.form-control(type="email", id="email", name="email", placeholder="Ex: joao.silva@email.com", required)

        .form-group
          label(for="senha") Senha
          input.form-control(type="password", id="senha", name="senha", placeholder="Mínimo 8 caracteres", required)

        .form-group
          label(for="tipo") Tipo de Usuário
          select.form-control(id="tipo", name="tipo", required)
            option(value="funcionario", selected) Funcionário
            option(value="admin") Administrador

        .form-actions
          button.btn.btn-primary(type="submit") Cadastrar Usuário
          a.btn.btn-secondary(href="/usuariocadastrado") Voltar