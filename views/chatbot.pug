extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css") // Garante que o estilo do painel seja carregado
  script(src="/javascripts/dashboard.js" defer) // Garante que o menu recolhível funcione

block content
  include header
  .page-container
    .page-header
      div
        h1.page-title Conexões Robô
        p.page-subtitle Gerencie os bots de atendimento conectados da sua empresa.
      button.btn.btn-primary(id="add-new-device-btn")
        i.fas.fa-plus.mr-2
        | Adicionar Dispositivo

    if error
      .alert.alert-danger= error

    if devices.length === 0
      .empty-state
        i.fas.fa-robot.empty-icon
        h3 Nenhum bot encontrado
        p Clique em "Adicionar Dispositivo" para conectar seu primeiro bot.
    else
      // Layout em cards, similar ao conectZap.pug
      .device-grid
        each device in devices
          .device-card(data-device-id=device.deviceIDchatbot)
            .card-header
              .device-info
                i.fas.fa-robot.device-icon
                .device-details
                  h5.device-name= device.number || 'Novo Dispositivo'
                  span.device-id= device.deviceIDchatbot
              -
                let statusClass = 'disconnected';
                let statusText = 'Desconhecido';
                if (device.status === 'connected') { statusClass = 'connected'; statusText = 'Conectado'; }
                else if (device.status === 'connecting') { statusClass = 'connecting'; statusText = 'Conectando'; }
                else if (device.status === 'disconnected') { statusClass = 'disconnected'; statusText = 'Desconectado'; }
              .status-badge(class=statusClass)
                .status-dot
                span= statusText
            .card-body
              .info-item
                span Última Conexão
                strong= device.last_connected ? new Date(device.last_connected).toLocaleString('pt-BR') : 'Nunca'
            .card-footer
              if device.status !== 'connected'
                button.btn.btn-sm.btn-success.connect-btn(data-device-id=device.deviceIDchatbot)
                  i.fas.fa-play.mr-1
                  | Conectar
              if device.status === 'connected'
                button.btn.btn-sm.btn-warning.disconnect-btn(data-device-id=device.deviceIDchatbot)
                  i.fas.fa-stop.mr-1
                  | Desconectar
              button.btn.btn-sm.btn-danger.remove-btn(data-device-id=device.deviceIDchatbot)
                i.fas.fa-trash.mr-1
                | Remover

    // Modal para exibir o QR Code
    #qrModal.modal(tabindex="-1")
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header
            h5.modal-title Escaneie para Conectar o Bot
            button.close(type="button", data-dismiss="modal")
              span &times;
          .modal-body.text-center
            #qrcode-container
              p Aguardando QR Code...

  // Scripts para interatividade da página
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const qrModal = $('#qrModal');
      const qrContainer = document.getElementById('qrcode-container');
      let qrCheckInterval = null;

      // Adicionar novo dispositivo
      document.getElementById('add-new-device-btn').addEventListener('click', async () => {
        try {
          const response = await fetch('/chatbot/add-device', { method: 'POST' });
          const data = await response.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert('Erro ao adicionar dispositivo: ' + (data.message || 'Tente novamente.'));
          }
        } catch (error) {
          console.error('Erro ao adicionar dispositivo:', error);
          alert('Ocorreu um erro de comunicação.');
        }
      });

      // Conectar dispositivo
      document.querySelectorAll('.connect-btn').forEach(button => {
        button.addEventListener('click', function() {
          const deviceId = this.getAttribute('data-device-id');
          qrContainer.innerHTML = '<p>Aguardando QR Code...</p>';
          qrModal.modal('show');

          if (qrCheckInterval) clearInterval(qrCheckInterval);

          const fetchQRCode = async () => {
            try {
              const response = await fetch(`/chatbot/qrcode/${deviceId}`);
              const data = await response.json();

              if (data.isReady) {
                qrModal.modal('hide');
                clearInterval(qrCheckInterval);
                window.location.reload();
                return;
              }

              if (data.qr) {
                qrContainer.innerHTML = `<img src="${data.qr}" alt="QR Code" style="max-width:240px; height:auto; border-radius:8px;">`;
              } else {
                qrContainer.innerHTML = '<p>Aguardando geração do QR Code...</p>';
              }
            } catch (error) {
              console.error('Erro ao buscar QR Code:', error);
              qrContainer.innerHTML = '<p style="color: red;">Erro ao carregar QR Code.</p>';
              clearInterval(qrCheckInterval);
            }
          };

          fetchQRCode();
          qrCheckInterval = setInterval(fetchQRCode, 3000);
        });
      });

      // Desconectar dispositivo
      document.querySelectorAll('.disconnect-btn').forEach(button => {
        button.addEventListener('click', async function() {
          const deviceId = this.getAttribute('data-device-id');
          if (!confirm(`Tem certeza que deseja desconectar o bot ${deviceId}?`)) return;

          try {
            const response = await fetch(`/chatbot/disconnect/${deviceId}`, { method: 'POST' });
            const data = await response.json();
            if (data.success) {
              window.location.reload();
            } else {
              alert('Erro ao desconectar: ' + (data.message || 'Tente novamente.'));
            }
          } catch (error) {
            console.error('Erro ao desconectar:', error);
            alert('Ocorreu um erro de comunicação.');
          }
        });
      });

      // Remover dispositivo
      document.querySelectorAll('.remove-btn').forEach(button => {
        button.addEventListener('click', async function() {
          const deviceId = this.getAttribute('data-device-id');
          if (!confirm(`ATENÇÃO: Isso removerá o bot ${deviceId} permanentemente. Deseja continuar?`)) return;

          try {
            const response = await fetch(`/chatbot/remove-device/${deviceId}`, { method: 'POST' });
            const data = await response.json();
            if (data.success) {
              window.location.reload();
            } else {
              alert('Erro ao remover: ' + (data.message || 'Tente novamente.'));
            }
          } catch (error) {
            console.error('Erro ao remover:', error);
            alert('Ocorreu um erro de comunicação.');
          }
        });
      });

      // Limpar intervalo quando o modal for fechado
      qrModal.on('hidden.bs.modal', function() {
        if (qrCheckInterval) clearInterval(qrCheckInterval);
        qrContainer.innerHTML = '';
      });
    });

```

### 2. Ajuste na Rota Principal (`app.js`)

Para que a nova página funcione, ajustei a rota `/conectBot` em `app.js` para renderizar o arquivo `chatbot.pug` (em vez de `conectBot.pug`), passando os dispositivos corretos para a view.

```diff
--- a/c/Service-management/app.js
+++ b/c/Service-management/app.js
        try {
          // Conectar ao WebSocket na mesma porta do servidor
          ws = new WebSocket(`ws://${window.location.hostname}:${window.location.port}/ws-chatbot`);
          
          ws.onopen = function() {
            console.log('WebSocket do chatbot conectado');
            setStatus('connecting', 'WebSocket conectado, iniciando bot...');
            reconnectAttempts = 0;
            
            // Solicitar conexão automática
            ws.send(JSON.stringify({ type: 'connect' }));
          };
          
          ws.onmessage = function(event) {
            try {
              const data = JSON.parse(event.data);
              console.log('Dados recebidos:', data);
              
              // Atualizar status
              if (data.status) {
                statusText.textContent = data.status;
              }
              
              // Atualizar indicador de status baseado no tipo
              switch (data.type) {
                case 'status':
                case 'connecting':
                  statusIndicator.className = 'status-indicator connecting';
                  break;
                case 'ready':
                  setStatus('connected','ChatBot WhatsApp conectado!');
                  qrcodePlaceholder.innerHTML = '<p style="color: green; font-size: 18px;">✅ ChatBot WhatsApp conectado! Bot ativo e funcionando.</p>';
                  connectBtn.disabled = true;
                  disconnectBtn.disabled = false;
                  break;
                case 'authenticated':
                  statusIndicator.className = 'status-indicator connected';
                  break;
                case 'disconnected':
                case 'auth_failure':
                  setStatus('disconnected','Aguardando geração do QR Code...');
                  connectBtn.disabled = false;
                  disconnectBtn.disabled = true;
                  break;
                case 'qr':
                  if (data.qr) {
                    // renderiza o <img> sem bordas inline — o CSS do whatsapp (#qrcode-placeholder e #qrcode-placeholder img)
                    // já aplica tamanho e borda pontilhada; aqui mantemos apenas sombras e radius iguais ao WhatsApp
                    qrcodePlaceholder.innerHTML = '<img src="' + data.qr + '" alt="QR Code" style="max-width:240px; max-height:240px; height:auto; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.5)" />';
                    statusIndicator.className = 'status-indicator connecting';
                  }
                  break;
                case 'error':
                  setStatus('error', '❌ Erro na conexão. Tente novamente.');
                  connectBtn.disabled = false;
                  disconnectBtn.disabled = true;
                  break;
                case 'pong':
                  // Resposta do ping - conexão ativa
                  break;
              }
            } catch (error) {
              console.error('Erro ao processar mensagem WebSocket:', error);
            }
          };
          
          ws.onerror = function(error) {
            console.error('Erro no WebSocket do chatbot:', error);
            setStatus('error', 'Erro na conexão WebSocket');
            connectBtn.disabled = false;
            disconnectBtn.disabled = true;
          };
          
          ws.onclose = function() {
            console.log('WebSocket do chatbot desconectado');
            setStatus('disconnected', 'Conexão WebSocket perdida');
            connectBtn.disabled = false;
            disconnectBtn.disabled = true;
            
            // Tentar reconectar automaticamente (limitado)
            if (reconnectAttempts < maxReconnectAttempts) {
              reconnectAttempts++;
              statusText.textContent = `Tentando reconectar... (${reconnectAttempts}/${maxReconnectAttempts})`;
              setTimeout(connectWebSocket, 3000);
            } else {
              statusText.textContent = 'Falha na reconexão. Clique em "Conectar Bot" para tentar novamente.';
              qrcodePlaceholder.innerHTML = '<p style="color: orange;">⚠️ Conexão perdida. Clique em "Conectar Bot" para reconectar.</p>';
            }
          };
        } catch (error) {
          console.error('Erro ao criar WebSocket:', error);
          setStatus('error', 'Erro ao conectar WebSocket');
          connectBtn.disabled = false;
          disconnectBtn.disabled = true;
        }
      }
      
      // Configurar botões
      connectBtn.addEventListener('click', function() {
        console.log('Botão conectar clicado');
        reconnectAttempts = 0; // Reset contador
        
        if (!ws || ws.readyState !== WebSocket.OPEN) {
          qrcodePlaceholder.innerHTML = '<p>Conectando...</p>';
          connectWebSocket();
        } else {
          // Se já estiver conectado, tentar inicializar novamente
          ws.send(JSON.stringify({ type: 'connect' }));
        }
        
        connectBtn.disabled = true;
        disconnectBtn.disabled = false;
      });
      
      disconnectBtn.addEventListener('click', function() {
        console.log('Botão desconectar clicado');
        
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({ type: 'disconnect' }));
        }
        
        if (ws) {
          ws.close();
          ws = null;
        }
        
        reconnectAttempts = maxReconnectAttempts; // Impedir reconexão automática
        setStatus('disconnected', 'ChatBot desconectado manualmente');
        qrcodePlaceholder.innerHTML = '<p>ChatBot desconectado</p>';
        connectBtn.disabled = false;
        disconnectBtn.disabled = true;
      });
      
      // Conectar automaticamente ao carregar a página
      connectWebSocket();
      
      // Ping periódico para manter conexão ativa
      setInterval(function() {
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({ type: 'ping' }));
        }
      }, 30000); // A cada 30 segundos
    });
  
  script(src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js")

  script.
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const deviceIDchatbot = urlParams.get('deviceIDchatbot');
      if (deviceIDchatbot) {
        function fetchQRCode() {
          fetch(`/chatbot/qrcode/${deviceIDchatbot}`)
            .then(res => res.json())
            .then(data => {
              const qrDiv = document.getElementById('qrcode-placeholder');
              if (data.success && data.qr) {
                // renderiza o QR como no whatsapp.pug (placeholder estilizado vem do whatsapp.css)
                qrDiv.innerHTML = `<img src="${data.qr}" alt="QR Code" style="max-width:240px; max-height:240px; height:auto; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.5)">`;
              } else {
                qrDiv.innerText = 'Aguardando QRCode...';
              }
            });
        }
        fetchQRCode();
        setInterval(fetchQRCode, 5000);
      }
    });
  
  script.
    (function() {
      // Poll /chatbot/qrcode/:deviceIDchatbot para detectar isReady e redirecionar
      function getQueryParam(name) {
        const params = new URLSearchParams(window.location.search);
        return params.get(name);
      }
      const deviceIDchatbot = getQueryParam('deviceIDchatbot');
      if (!deviceIDchatbot) return;

      let polling = null;
      async function checkQr() {
        try {
          const res = await fetch('/chatbot/qrcode/' + encodeURIComponent(deviceIDchatbot));
          const data = await res.json();
          // quando autenticado/ready -> redireciona para lista de bots
          if (data && data.isReady) {
            if (polling) { clearInterval(polling); polling = null; }
            // redireciona para a listagem de conectores (conectBot)
            window.location.href = '/conectBot';
            return;
          }
          // opcional: exibir QR na página se data.qr estiver presente (sua UI pode já fazer isso)
        } catch (e) {
          console.warn('checkQr erro', e);
        }
      }

      // roda imediatamente e depois em intervalos
      checkQr();
      polling = setInterval(checkQr, 2000);
    })();
