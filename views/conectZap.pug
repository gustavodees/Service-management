extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  script(src="/javascripts/dashboard.js" defer)

block content
  include header
  // Adicionado um container principal para o novo layout
  .page-container
    .page-header
      div
        h1.page-title Conexões WhatsApp
        p.page-subtitle Gerencie os dispositivos conectados da sua empresa.
      button.btn.btn-primary(id="add-new-device-btn")
        i.fas.fa-plus.mr-2
        | Adicionar Dispositivo

    if error
      .alert.alert-danger= error

    if devices.length === 0
      .empty-state
        i.fas.fa-mobile-alt.empty-icon
        h3 Nenhum dispositivo encontrado
        p Clique em "Adicionar Dispositivo" para conectar seu primeiro número de WhatsApp.
    else
      // Novo layout em cards
      .device-grid
        each device in devices
          .device-card(data-device-id=device.device_id)
            .card-header
              .device-info
                i.fab.fa-whatsapp.device-icon
                .device-details
                  h5.device-name= device.number || 'Novo Dispositivo'
                  span.device-id= device.device_id
              -
                let statusClass = 'disconnected';
                let statusText = 'Desconhecido';
                if (device.status === 'connected') { statusClass = 'connected'; statusText = 'Conectado'; }
                else if (device.status === 'connecting') { statusClass = 'connecting'; statusText = 'Conectando'; }
                else if (device.status === 'disconnected') { statusClass = 'disconnected'; statusText = 'Desconectado'; }
              .status-badge(class=statusClass)
                .status-dot
                span= statusText
            .card-body
              .info-item
                span Última Conexão
                strong= device.last_connected ? new Date(device.last_connected).toLocaleString('pt-BR') : 'Nunca'

            //- Adicionado: Seção da barra de progresso (escondida por padrão)
            .card-progress(id=`progress-container-${device.device_id}` style="display: none;")
              .progress-info
                span.progress-label Sincronizando...
                span.progress-percentage(id=`progress-text-${device.device_id}`) 0%
              .progress-bar
                .progress-bar-fill(id=`progress-bar-${device.device_id}`)

            .card-footer
              if device.status !== 'connected'
                button.btn.btn-success.connect-btn(data-device-id=device.device_id, style="width: 100%;")
                  i.fas.fa-play.mr-1
                  | Conectar
              else
                //- Adicionado: Botão para iniciar a sincronização
                button.btn-icon-action.sync-btn(data-device-id=device.device_id, title="Sincronizar Contatos e Mensagens")
                  i.fas.fa-sync-alt

                // Botões de ícone para ações secundárias
                button.btn-icon-action.disconnect-btn(data-device-id=device.device_id, title="Desconectar")
                  i.fas.fa-power-off
                button.btn-icon-action.danger.remove-btn(data-device-id=device.device_id, title="Remover")
                  i.fas.fa-trash

  

    //- Adicionado: Script para fazer o botão de adicionar dispositivo funcionar
    script.
      document.addEventListener('DOMContentLoaded', function() {
        const addDeviceBtn = document.getElementById('add-new-device-btn');
        if (addDeviceBtn) {
          addDeviceBtn.addEventListener('click', () => {
            // Redireciona para a página que inicia o processo de criação e QR Code
            window.location.href = '/whatsapp';
          });
        }

        // Adicionado: Lógica para os botões de remover, conectar e desconectar
        document.querySelectorAll('.remove-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (confirm(`Tem certeza que deseja remover o dispositivo ${deviceId}? Esta ação não pode ser desfeita.`)) {
              try {
                const response = await fetch(`/whatsapp/remove-device?deviceId=${deviceId}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                  alert('Dispositivo removido com sucesso!');
                  window.location.reload();
                } else {
                  alert('Erro ao remover dispositivo: ' + (result.message || 'Erro desconhecido'));
                }
              } catch (error) {
                alert('Erro de comunicação ao tentar remover o dispositivo.');
              }
            }
          });
        });

        document.querySelectorAll('.connect-btn').forEach(button => {
          button.addEventListener('click', (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            // Redireciona para a página do QR Code com o deviceId específico
            window.location.href = `/whatsapp?deviceId=${deviceId}`;
          });
        });

        // Adicionado: Lógica para o botão de desconectar
        document.querySelectorAll('.disconnect-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (confirm(`Tem certeza que deseja desconectar o dispositivo ${deviceId}? Você precisará escanear o QR Code novamente.`)) {
              try {
                const response = await fetch(`/whatsapp/disconnect-device?deviceId=${deviceId}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                  alert('Dispositivo desconectado com sucesso!');
                  window.location.reload();
                } else {
                  alert('Erro ao desconectar dispositivo: ' + (result.message || 'Erro desconhecido'));
                }
              } catch (error) {
                alert('Erro de comunicação ao tentar desconectar o dispositivo.');
              }
            }
          });
        });

        // Adicionado: Lógica para o botão de sincronizar
        document.querySelectorAll('.sync-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (!confirm(`Iniciar a sincronização de contatos e mensagens para o dispositivo ${deviceId}?`)) {
              return;
            }

            const progressContainer = document.getElementById(`progress-container-${deviceId}`);
            const progressBar = document.getElementById(`progress-bar-${deviceId}`);
            const progressText = document.getElementById(`progress-text-${deviceId}`);

            progressContainer.style.display = 'block';
            progressBar.style.width = '0%';
            progressText.textContent = '0%';

            try {
              // 1. Inicia o processo no backend e obtém um ID da tarefa
              const startResponse = await fetch(`/whatsapp/start-sync/${deviceId}`, { method: 'POST' });
              const { taskId } = await startResponse.json();

              // 2. Verifica o progresso periodicamente
              const intervalId = setInterval(async () => {
                const statusResponse = await fetch(`/whatsapp/sync-status/${taskId}`);
                const { progress, message } = await statusResponse.json();

                // 3. Atualiza a UI
                progressBar.style.width = progress + '%';
                progressText.textContent = progress + '%';

                if (progress >= 100) {
                  clearInterval(intervalId);
                  progressText.textContent = "Concluído!";
                  // Opcional: esconder a barra após um tempo
                  setTimeout(() => { progressContainer.style.display = 'none'; alert('Sincronização concluída! Os contatos já devem aparecer na aba de Atendimento.'); }, 2000);
                }
              }, 3000); // Verifica a cada 3 segundos
            } catch (error) {
              console.error('Erro ao iniciar sincronização:', error);
              alert('Não foi possível iniciar a sincronização. Verifique o console para mais detalhes.');
              progressContainer.style.display = 'none';
            }
          });
        });

        // Adicionado: Lógica para o botão de sincronizar
        document.querySelectorAll('.sync-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (!confirm(`Iniciar a sincronização de contatos e mensagens para o dispositivo ${deviceId}?`)) {
              return;
            }

            const progressContainer = document.getElementById(`progress-container-${deviceId}`);
            const progressBar = document.getElementById(`progress-bar-${deviceId}`);
            const progressText = document.getElementById(`progress-text-${deviceId}`);

            progressContainer.style.display = 'block';
            progressBar.style.width = '0%';
            progressText.textContent = '0%';

            try {
              // 1. Inicia o processo no backend e obtém um ID da tarefa
              const startResponse = await fetch(`/whatsapp/start-sync/${deviceId}`, { method: 'POST' });
              const { taskId } = await startResponse.json();

              // 2. Verifica o progresso periodicamente
              const intervalId = setInterval(async () => {
                const statusResponse = await fetch(`/whatsapp/sync-status/${taskId}`);
                const { progress, message } = await statusResponse.json();

                // 3. Atualiza a UI
                progressBar.style.width = progress + '%';
                progressText.textContent = progress + '%';

                if (progress >= 100) {
                  clearInterval(intervalId);
                  progressText.textContent = "Concluído!";
                  // Opcional: esconder a barra após um tempo
                  setTimeout(() => { progressContainer.style.display = 'none'; alert('Sincronização concluída! Os contatos já devem aparecer na aba de Atendimento.'); }, 2000);
                }
              }, 3000); // Verifica a cada 3 segundos
            } catch (error) {
              console.error('Erro ao iniciar sincronização:', error);
              alert('Não foi possível iniciar a sincronização. Verifique o console para mais detalhes.');
              progressContainer.style.display = 'none';
            }
          });
        });

        // --- ADICIONADO: Lógica para WebSocket ---
        // Conecta ao WebSocket para receber atualizações em tempo real
        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${wsProtocol}//${window.location.host}`);

        ws.onmessage = function(event) {
            const data = JSON.parse(event.data);

            // Ouve o evento de início de sincronização automática
            if (data.type === 'sync-started' && data.taskId) {
                const deviceId = data.deviceId;
                console.log(`Sincronização automática iniciada para ${deviceId} com taskId ${data.taskId}`);

                const progressContainer = document.getElementById(`progress-container-${deviceId}`);
                const progressBar = document.getElementById(`progress-bar-${deviceId}`);
                const progressText = document.getElementById(`progress-text-${deviceId}`);

                if (progressContainer) {
                    progressContainer.style.display = 'block';
                    progressBar.style.width = '0%';
                    progressText.textContent = '0%';

                    // Inicia o monitoramento do progresso para esta tarefa
                    monitorSyncProgress(data.taskId, deviceId);
                }
            }

            // Outros eventos de WebSocket podem ser tratados aqui (ex: status-change)
            if (data.type === 'whatsapp-connected' || data.type === 'disconnected') {
                // Recarrega a página para refletir o novo status do dispositivo
                // É uma abordagem simples mas eficaz.
                console.log(`Status do dispositivo ${data.deviceId} alterado. Recarregando...`);
                window.location.reload();
            }
        };
      });