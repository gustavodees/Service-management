extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  script(src="/javascripts/dashboard.js" defer)

block content
  include header
  // Adicionado um container principal para o novo layout
  .page-container
    .page-header
      div
        h1.page-title Conexões WhatsApp
        p.page-subtitle Gerencie os dispositivos conectados da sua empresa.
      button.btn.btn-primary(id="add-new-device-btn")
        i.fas.fa-plus.mr-2
        | Adicionar Dispositivo

    if error
      .alert.alert-danger= error

    if devices.length === 0
      .empty-state
        i.fas.fa-mobile-alt.empty-icon
        h3 Nenhum dispositivo encontrado
        p Clique em "Adicionar Dispositivo" para conectar seu primeiro número de WhatsApp.
    else
      // Novo layout em cards
      .device-grid
        each device in devices
          .device-card(data-device-id=device.device_id)
            .card-header
              .device-info
                i.fab.fa-whatsapp.device-icon
                .device-details
                  h5.device-name= device.number || 'Novo Dispositivo'
                  span.device-id= device.device_id
              -
                let statusClass = 'disconnected';
                let statusText = 'Desconhecido';
                if (device.status === 'connected') { statusClass = 'connected'; statusText = 'Conectado'; }
                else if (device.status === 'connecting') { statusClass = 'connecting'; statusText = 'Conectando'; }
                else if (device.status === 'disconnected') { statusClass = 'disconnected'; statusText = 'Desconectado'; }
              .status-badge(class=statusClass)
                .status-dot
                span= statusText
            .card-body
              .info-item
                span Última Conexão
                strong= device.last_connected ? new Date(device.last_connected).toLocaleString('pt-BR') : 'Nunca'
            .card-footer
              if device.status !== 'connected'
                button.btn.btn-sm.btn-success.connect-btn(data-device-id=device.device_id)
                  i.fas.fa-play.mr-1
                  | Conectar
              if device.status === 'connected'
                button.btn.btn-sm.btn-warning.disconnect-btn(data-device-id=device.device_id)
                  i.fas.fa-stop.mr-1
                  | Desconectar
              button.btn.btn-sm.btn-danger.remove-btn(data-device-id=device.device_id)
                i.fas.fa-trash.mr-1
                | Remover

    // Modal para exibir o QR Code
    #qrModal.modal(tabindex="-1")
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header
            h5.modal-title Escaneie para Conectar
            button.close(type="button", data-dismiss="modal")
              span &times;
          .modal-body.text-center
            #qrcode-container
              p Aguardando QR Code...

    //- Adicionado: Script para fazer o botão de adicionar dispositivo funcionar
    script.
      document.addEventListener('DOMContentLoaded', function() {
        const addDeviceBtn = document.getElementById('add-new-device-btn');
        if (addDeviceBtn) {
          addDeviceBtn.addEventListener('click', () => {
            // Redireciona para a página que inicia o processo de criação e QR Code
            window.location.href = '/whatsapp';
          });
        }

        // Adicionado: Lógica para os botões de remover, conectar e desconectar
        document.querySelectorAll('.remove-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (confirm(`Tem certeza que deseja remover o dispositivo ${deviceId}? Esta ação não pode ser desfeita.`)) {
              try {
                const response = await fetch(`/whatsapp/remove-device?deviceId=${deviceId}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                  alert('Dispositivo removido com sucesso!');
                  window.location.reload();
                } else {
                  alert('Erro ao remover dispositivo: ' + (result.message || 'Erro desconhecido'));
                }
              } catch (error) {
                alert('Erro de comunicação ao tentar remover o dispositivo.');
              }
            }
          });
        });

        document.querySelectorAll('.connect-btn').forEach(button => {
          button.addEventListener('click', (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            // Redireciona para a página do QR Code com o deviceId específico
            window.location.href = `/whatsapp?deviceId=${deviceId}`;
          });
        });

        // Adicionado: Lógica para o botão de desconectar
        document.querySelectorAll('.disconnect-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = event.target.closest('button').dataset.deviceId;
            if (confirm(`Tem certeza que deseja desconectar o dispositivo ${deviceId}? Você precisará escanear o QR Code novamente.`)) {
              try {
                const response = await fetch(`/whatsapp/disconnect-device?deviceId=${deviceId}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                  alert('Dispositivo desconectado com sucesso!');
                  window.location.reload();
                } else {
                  alert('Erro ao desconectar dispositivo: ' + (result.message || 'Erro desconhecido'));
                }
              } catch (error) {
                alert('Erro de comunicação ao tentar desconectar o dispositivo.');
              }
            }
          });
        });
      });