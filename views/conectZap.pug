extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  script(src="/javascripts/dashboard.js" defer)

block content
  include header
  // Adicionado um container principal para o novo layout
  .page-container
    .page-header
      div
        h1.page-title Conexões WhatsApp
        p.page-subtitle Gerencie os dispositivos conectados da sua empresa.
      button.btn.btn-primary(id="add-new-device-btn")
        i.fas.fa-plus.mr-2
        | Adicionar Dispositivo

    if error
      .alert.alert-danger= error

    if devices.length === 0
      .empty-state
        i.fas.fa-mobile-alt.empty-icon
        h3 Nenhum dispositivo encontrado
        p Clique em "Adicionar Dispositivo" para conectar seu primeiro número de WhatsApp.
    else
      // Novo layout em cards
      .device-grid
        each device in devices
          .device-card(data-device-id=device.device_id)
            .card-header
              .device-info
                i.fab.fa-whatsapp.device-icon
                .device-details
                  h5.device-name= device.number || 'Novo Dispositivo'
                  span.device-id= device.device_id
              -
                let statusClass = 'disconnected';
                let statusText = 'Desconhecido';
                if (device.status === 'connected') { statusClass = 'connected'; statusText = 'Conectado'; }
                else if (device.status === 'connecting') { statusClass = 'connecting'; statusText = 'Conectando'; }
                else if (device.status === 'disconnected') { statusClass = 'disconnected'; statusText = 'Desconectado'; }
              .status-badge(class=statusClass)
                .status-dot
                span= statusText
            .card-body
              .info-item
                span Última Conexão
                strong= device.last_connected ? new Date(device.last_connected).toLocaleString('pt-BR') : 'Nunca'

            //- Adicionado: Seção da barra de progresso (escondida por padrão)
            .card-progress(id=`progress-container-${device.device_id}`)
              .progress-info
                .progress-status
                  i.fas.fa-sync-alt.progress-icon
                  span.progress-message(id=`progress-message-${device.device_id}`) Preparando sincronização...
                span.progress-percentage(id=`progress-text-${device.device_id}`) 0%
              .progress-bar
                .progress-bar-fill(id=`progress-bar-${device.device_id}`)

            .card-footer
              if device.status !== 'connected'
                button.btn.btn-success.connect-btn(data-device-id=device.device_id, style="width: 100%;")
                  i.fas.fa-play.mr-1
                  | Conectar
              else
                //- Adicionado: Botão para iniciar a sincronização
                button.btn-icon-action.sync-btn(data-device-id=device.device_id, title="Sincronizar Contatos e Mensagens")
                  i.fas.fa-sync-alt

                // Botões de ícone para ações secundárias
                button.btn-icon-action.disconnect-btn(data-device-id=device.device_id, title="Desconectar")
                  i.fas.fa-power-off
                button.btn-icon-action.danger.remove-btn(data-device-id=device.device_id, title="Remover")
                  i.fas.fa-trash

  

    //- Adicionado: Script para fazer o botão de adicionar dispositivo funcionar
    script.
      document.addEventListener('DOMContentLoaded', function() {
        const addDeviceBtn = document.getElementById('add-new-device-btn');
        const progressIntervals = {};

        const getDeviceId = (element) => {
          if (!element) return null;
          return element.dataset.deviceId || element.closest('[data-device-id]')?.dataset.deviceId || element.closest('button')?.dataset.deviceId || null;
        };

        const getProgressElements = (deviceId) => {
          const container = document.getElementById(`progress-container-${deviceId}`);
          return {
            container,
            bar: document.getElementById(`progress-bar-${deviceId}`),
            text: document.getElementById(`progress-text-${deviceId}`),
            message: document.getElementById(`progress-message-${deviceId}`),
            icon: container ? container.querySelector('.progress-icon') : null,
          };
        };

        function resetProgress(deviceId) {
          const els = getProgressElements(deviceId);
          if (!els.container) return;
          els.container.classList.remove('active', 'success', 'error');
          if (els.bar) els.bar.style.width = '0%';
          if (els.text) els.text.textContent = '0%';
          if (els.message) els.message.textContent = 'Aguardando sincronização...';
          if (els.icon) els.icon.className = 'fas fa-sync-alt progress-icon';
        }

        function setProgressState(deviceId, { progress = 0, message = 'Sincronizando...', state = 'running' }) {
          const els = getProgressElements(deviceId);
          if (!els.container) return;

          const clamped = Math.min(100, Math.max(0, Math.round(progress)));
          els.container.classList.add('active');
          els.container.classList.remove('success', 'error');

          if (state === 'success') {
            els.container.classList.add('success');
            if (els.icon) els.icon.className = 'fas fa-check-circle progress-icon';
          } else if (state === 'error') {
            els.container.classList.add('error');
            if (els.icon) els.icon.className = 'fas fa-triangle-exclamation progress-icon';
          } else {
            if (els.icon) els.icon.className = 'fas fa-sync-alt fa-spin progress-icon';
          }

          if (els.bar) els.bar.style.width = `${clamped}%`;
          if (els.text) els.text.textContent = `${clamped}%`;
          if (els.message) els.message.textContent = message;
        }

        function hideProgress(deviceId, delay = 2500) {
          setTimeout(() => resetProgress(deviceId), delay);
        }

        function clearMonitor(deviceId) {
          if (progressIntervals[deviceId]) {
            clearInterval(progressIntervals[deviceId]);
            delete progressIntervals[deviceId];
          }
        }

        async function monitorSyncProgress(taskId, deviceId) {
          if (!taskId) return;
          clearMonitor(deviceId);

          const poll = async () => {
            try {
              const response = await fetch(`/whatsapp/sync-status/${taskId}`);
              const data = await response.json();
              const progress = typeof data.progress === 'number' ? data.progress : 0;
              const message = data.message || 'Sincronizando conversas...';
              const done = data.done === true || progress >= 100;
              const errorMessage = data.error;

              if (errorMessage) {
                setProgressState(deviceId, { progress: 100, message: `Erro: ${errorMessage}`, state: 'error' });
                clearMonitor(deviceId);
                hideProgress(deviceId, 4000);
                return;
              }

              setProgressState(deviceId, { progress: done ? 100 : progress, message, state: done ? 'success' : 'running' });

              if (done) {
                clearMonitor(deviceId);
                hideProgress(deviceId);
              }
            } catch (error) {
              console.error('Erro ao monitorar sincronização:', error);
              setProgressState(deviceId, { progress: 100, message: 'Falha ao monitorar sincronização.', state: 'error' });
              clearMonitor(deviceId);
              hideProgress(deviceId, 4000);
            }
          };

          await poll();
          progressIntervals[deviceId] = setInterval(poll, 2500);
        }

        async function startManualSync(deviceId) {
          try {
            setProgressState(deviceId, { progress: 5, message: 'Iniciando sincronização...', state: 'running' });
            const response = await fetch(`/whatsapp/start-sync/${deviceId}`, { method: 'POST' });
            const payload = await response.json();
            if (!response.ok || !payload.success || !payload.taskId) {
              throw new Error(payload.error || 'Não foi possível iniciar a sincronização.');
            }
            monitorSyncProgress(payload.taskId, deviceId);
          } catch (error) {
            console.error('Erro ao iniciar sincronização:', error);
            setProgressState(deviceId, { progress: 100, message: error.message || 'Erro ao iniciar sincronização.', state: 'error' });
            hideProgress(deviceId, 4000);
          }
        }

        if (addDeviceBtn) {
          addDeviceBtn.addEventListener('click', () => {
            window.location.href = '/whatsapp';
          });
        }

        document.querySelectorAll('.remove-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = getDeviceId(event.currentTarget);
            if (!deviceId) return;
            if (!confirm(`Tem certeza que deseja remover o dispositivo ${deviceId}? Esta ação não pode ser desfeita.`)) {
              return;
            }
            try {
              const response = await fetch(`/whatsapp/remove-device?deviceId=${deviceId}`, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                alert('Dispositivo removido com sucesso!');
                window.location.reload();
              } else {
                alert('Erro ao remover dispositivo: ' + (result.message || 'Erro desconhecido'));
              }
            } catch (error) {
              alert('Erro de comunicação ao tentar remover o dispositivo.');
            }
          });
        });

        document.querySelectorAll('.connect-btn').forEach(button => {
          button.addEventListener('click', (event) => {
            const deviceId = getDeviceId(event.currentTarget);
            if (deviceId) {
              window.location.href = `/whatsapp?deviceId=${deviceId}`;
            }
          });
        });

        document.querySelectorAll('.disconnect-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = getDeviceId(event.currentTarget);
            if (!deviceId) return;
            if (!confirm(`Tem certeza que deseja desconectar o dispositivo ${deviceId}? Você precisará escanear o QR Code novamente.`)) {
              return;
            }
            try {
              const response = await fetch(`/whatsapp/disconnect-device?deviceId=${deviceId}`, { method: 'POST' });
              const result = await response.json();
              if (result.success) {
                alert('Dispositivo desconectado com sucesso!');
                window.location.reload();
              } else {
                alert('Erro ao desconectar dispositivo: ' + (result.message || 'Erro desconhecido'));
              }
            } catch (error) {
              alert('Erro de comunicação ao tentar desconectar o dispositivo.');
            }
          });
        });

        document.querySelectorAll('.sync-btn').forEach(button => {
          button.addEventListener('click', async (event) => {
            const deviceId = getDeviceId(event.currentTarget);
            if (!deviceId) return;
            if (!confirm(`Iniciar a sincronização de contatos e mensagens para o dispositivo ${deviceId}?`)) {
              return;
            }
            await startManualSync(deviceId);
          });
        });

        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${wsProtocol}//${window.location.host}`);

        ws.onmessage = function(event) {
            const data = JSON.parse(event.data);

            if (data.type === 'sync-started') {
                const deviceId = data.deviceId;
                if (!deviceId) return;
                setProgressState(deviceId, { progress: 5, message: 'Sincronização automática iniciada...', state: 'running' });
                if (data.taskId) {
                    monitorSyncProgress(data.taskId, deviceId);
                } else {
                    hideProgress(deviceId, 3000);
                }
            }

            if (data.type === 'whatsapp-connected' || data.type === 'disconnected') {
                console.log(`Status do dispositivo ${data.deviceId} alterado. Recarregando...`);
                window.location.reload();
            }
        };
      });