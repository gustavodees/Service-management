extends layout

block head
  //- Adiciona a classe ao body para estilos específicos da página de atendimento (como overflow: hidden)
  style.
    document.addEventListener('DOMContentLoaded', function() {
      document.body.classList.add('atendimento-active');
    });
  //- Remove a classe ao sair da página para não afetar outras telas
  script(nonce=nonce).
    window.addEventListener('beforeunload', function() {
      document.body.classList.remove('atendimento-active');
    });

block content
  include header
  //- A classe 'main-full-width' remove os paddings do <main> para que o container ocupe 100% do espaço
  main.main-full-width
    .atendimento-container

      //- ==========================================================
      //- Coluna 1: Painel de Conversas (Esquerda)
      //- ==========================================================
      .conversations-panel
        .conversations-header
          input#search-conversation(type="text", placeholder="Pesquisar ou começar uma nova conversa")
        .conversation-tabs
          button#tab-contacts.tab-btn.active Contatos
          button#tab-groups.tab-btn Grupos
          button#tab-archived.tab-btn Arquivados
        #conversations-list
          //- Modificado: Estado inicial de carregamento.
          //- O script atendimento-ws.js irá substituir isso pela lista de contatos ou por uma mensagem de "Nenhum contato encontrado".
          .loading-state
            i.fa-solid.fa-spinner.fa-spin
            p Carregando contatos...

      //- ==========================================================
      //- Coluna 2: Painel do Chat (Centro)
      //- ==========================================================
      .chat-panel
        //- Cabeçalho do chat, atualizado pelo JS
        .chat-header
          h3#current-chat-title Selecione uma conversa

        //- ADICIONADO: Barra de progresso para sincronização
        .sync-progress-bar#sync-progress-container(style="display: none;")
          .sync-progress-text#sync-progress-text Sincronizando...
          .progress-bar-outer
            .progress-bar-inner#sync-progress-bar

        //- Área de mensagens
        #chat-messages
          .empty-chat
            i.fa-solid.fa-headset
            p Selecione uma conversa para começar

        //- Área de input de mensagem
        .chat-input-area
          //- Controles de gravação de áudio (escondidos por padrão)
          .audio-recording-controls#audio-controls
            .recording-indicator
              i.fa-solid.fa-circle.recording-pulse
              span Gravando...
            .recording-timer#recording-timer 00:00
            .recording-actions
              button.btn-icon.stop#stop-recording(title="Enviar gravação")
                i.fa-solid.fa-paper-plane
              button.btn-icon.cancel#cancel-recording(title="Cancelar gravação")
                i.fa-solid.fa-trash

          //- Botões de ação e input
          button.btn-icon#audio-record-btn(title="Gravar áudio")
            i.fa-solid.fa-microphone
          button.btn-icon#file-clip-btn(title="Anexar arquivo")
            i.fa-solid.fa-paperclip
          input#file-input(type="file", hidden)
          textarea#message-input(rows="1", placeholder="Digite uma mensagem...", disabled)
          button.btn-icon#send-message-btn(title="Enviar mensagem", disabled)
            i.fa-solid.fa-paper-plane

      //- ==========================================================
      //- Coluna 3: Painel de Detalhes (Direita)
      //- ==========================================================
      .details-panel
        //- Seção de Tabulação
        section.details-section
          h4
            i.fa-solid.fa-tags
            | Tabular Conversa
          .details-content
            .form-group
              label.required(for="tabulacao-select") Status da Tabulação
              select#tabulacao-select.form-control(required)
                option(value="", disabled, selected) Selecione um status...
                option(value="aniversariantes") Aniversariantes
                option(value="sem-possibilidade") Sem Possibilidade
                option(value="conversa-inativa") Conversa Inativa
                option(value="mudancas-cadastrais") Mudanças Cadastrais
                option(value="negocio-fechado") Negócio Fechado
                option(value="sem-interesse") Sem Interesse
            .form-group#campo-aniversario(style="display: none;")
              label.required(for="aniversario-data") Data de Aniversário
              input#aniversario-data(type="date")
            .form-group
              label(for="detalhes-conversa") Detalhes da Conversa
              textarea#detalhes-conversa(rows="3", placeholder="Detalhes importantes da conversa...")
            .form-group
              label(for="observacoes-tab") Observações
              textarea#observacoes-tab(rows="3", placeholder="Observações internas...")
            button#btn-tabular.btn-primary(disabled) Tabular e Finalizar

        //- Seção de Respostas Rápidas
        section.details-section.quick-responses-section
          h4
            i.fa-solid.fa-bolt-lightning
            | Respostas Rápidas
          .details-content
            button.quick-btn(data-response="dados bancarios") Dados Bancários
            button.quick-btn(data-response="verificacao") Verificação de Contrato
            button.quick-btn(data-response="ajuda") Posso ajudar?
            button.quick-btn(data-response="aguardar") Aguarde um momento
            button.quick-btn(data-response="despedida") Despedida

  // Bibliotecas necessárias para conversão MP3
  script(src="https://cdn.jsdelivr.net/npm/lamejs@1.2.0/lame.min.js")
  script(src="/javascripts/audio-utils.js")
  script(src="/javascripts/video-utils.js")
  script(src="/javascripts/atendimento-ws.js" defer)
