extends layout

block content
  include header
  .main-content
    .container-fluid
      .card.custom-card
        .card-header
          h2.card-title Gerenciar Empresas
          p.card-subtitle Visualize e gerencie todas as empresas cadastradas no sistema.

        .card-body
          if empresas && empresas.length > 0
            .table-responsive
              table.table.table-hover.table-striped.custom-table
                thead
                  tr
                    th Nome Fantasia
                    th CNPJ
                    th Status
                    th Usuários
                    th Ações

                tbody
                  each empresa in empresas
                    tr
                      td= empresa.nome_fantasia
                      td= empresa.cnpj
                      td
                        case empresa.status
                          when 2
                            span.badge.badge-success Aprovado
                          when 1
                            span.badge.badge-warning Pendente
                          when -1
                            span.badge.badge-secondary Bloqueado
                          when -2
                            span.badge.badge-danger Rejeitado
                          default
                            span.badge.badge-light Desconhecido
                      td= empresa.Usuarios ? empresa.Usuarios.length : 0
                      td
                        //- Botão Editar (ainda a ser implementado)
                        a.btn.btn-sm.btn-outline-primary.mr-2(href=`/admin/editar-empresa/${empresa.id}`, title="Editar Empresa")
                          i.fas.fa-pencil-alt

                        //- Botão Excluir com confirmação
                        button.btn.btn-sm.btn-outline-danger(
                          type="button",
                          title="Remover Empresa",
                          onclick=`confirmarRemocao(${empresa.id}, '${empresa.nome_fantasia}')`
                        )
                          i.fas.fa-trash-alt
          else
            .alert.alert-info Nenhuma empresa cadastrada para gerenciar.

  //- Formulário oculto para a exclusão
  form#form-remover-empresa(method="POST", style="display: none;")

  //- Script para confirmação de exclusão
  script.
    function confirmarRemocao(id, nome) {
      if (confirm(`Tem certeza que deseja remover a empresa "${nome}"?\n\nATENÇÃO: Esta ação é irreversível e removerá todos os usuários e dados associados a esta empresa.`)) {
        const form = document.getElementById('form-remover-empresa');
        form.action = `/admin/remover-empresa/${id}`;
        form.submit();
      }
    }

  //- Adiciona um pouco de estilo para os badges
  style.
    .badge {
      font-size: 0.85em;
      padding: 0.5em 0.7em;
    }
    .custom-table td {
      vertical-align: middle;
    }