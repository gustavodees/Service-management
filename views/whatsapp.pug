extends layout

block head
  link(rel="stylesheet", href="/stylesheets/dashboard.css")
  link(rel="stylesheet", href="/stylesheets/whatsapp.css")
  // Adiciona Font Awesome
  link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css")

block content
  include header
  .whatsapp-container
    .whatsapp-card
      h3 Conectar Novo Dispositivo
      .scan-button Escaneie o QR Code com seu celular
      
      // Container onde o QR Code será gerado
      #qrcode-placeholder
        // A imagem será inserida aqui
        img#qrcode-image(src="", alt="QR Code", style="display: none;")
        .placeholder-content
          span Aguardando QR Code...

      // Texto de status
      .status-text-container
        .status-dot(id="status-dot")
        span#status-text Aguardando conexão...

  script.
    document.addEventListener('DOMContentLoaded', async () => {
      const getQueryParam = (name) => new URLSearchParams(window.location.search).get(name);
      const deviceId = getQueryParam('deviceId');
      const qrcodePlaceholder = document.getElementById('qrcode-placeholder');
      const qrcodeImage = document.getElementById('qrcode-image');
      const statusTextEl = document.getElementById('status-text');
      const statusDotEl = document.getElementById('status-dot');

      const setStatus = (state, text) => {
        if (!statusTextEl || !statusDotEl) return;
        
        statusDotEl.className = 'status-dot';
        statusDotEl.classList.add(state);
        
        statusTextEl.textContent = text;
      };

      if (!deviceId) {
        setStatus('connecting', 'Criando novo dispositivo...');
        try {
          const res = await fetch('/whatsapp/new-device', { method: 'POST' });
          const data = await res.json();
          if (data.success && data.deviceId) {
            const url = new URL(window.location.href);
            url.searchParams.set('deviceId', data.deviceId);
            window.location.href = url.toString();
          } else {
            setStatus('error', 'Falha ao criar novo dispositivo.');
          }
        } catch (error) {
          setStatus('error', 'Erro ao criar dispositivo.');
        }
        return;
      }

      try {
        await fetch(`/whatsapp/start/${encodeURIComponent(deviceId)}`, { method: 'POST' });
      } catch (e) {
        setStatus('error', 'Erro ao iniciar dispositivo');
        console.error('Falha ao iniciar dispositivo:', e);
      }

      const ws = new WebSocket(`ws://${window.location.host}`);

      ws.onopen = () => console.log('WebSocket conectado.');
      ws.onerror = (err) => {
        console.error('Erro no WebSocket:', err);
        setStatus('error', 'Erro na conexão em tempo real.');
      };
      
      ws.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          if (data.deviceId !== deviceId) return;

          switch (data.type) {
            case 'qr-code': // CORREÇÃO: O evento agora é 'qr-code'
              setStatus('connecting', 'QR Code recebido. Escaneie abaixo.');
              
              // A mágica acontece aqui: o servidor já envia a imagem pronta (data.qrDataURL)
              if (data.qrDataURL) {
                qrcodePlaceholder.innerHTML = ''; // Limpa o "Aguardando..."
                qrcodeImage.src = data.qrDataURL; // Define a imagem
                qrcodeImage.style.display = 'block'; // Mostra a imagem
                qrcodePlaceholder.appendChild(qrcodeImage); // Garante que a imagem está dentro do placeholder
              } else {
                setStatus('error', 'Recebido QR Code inválido do servidor.');
              }
              break;
            case 'whatsapp-connected': // Corrigido: O evento enviado pelo manager é 'whatsapp-connected'
              setStatus('connected', 'Dispositivo conectado! Redirecionando...');
              setTimeout(() => { window.location.href = '/conectZap'; }, 1500);
              break;
            case 'disconnected':
              setStatus('disconnected', 'Dispositivo desconectado. Recarregue a página para tentar novamente.');
              if (qrcodeImage) qrcodeImage.style.display = 'none';
              qrcodePlaceholder.innerHTML = '<div class="placeholder-content"><span>Dispositivo desconectado.</span></div>';
              break;
            case 'error':
              setStatus('error', data.status || 'Erro na conexão.');
              qrcodePlaceholder.innerHTML = '<div class="placeholder-content"><span style="color: red;">Não foi possível gerar o QR Code. Tente novamente.</span></div>';
              break;
          }
        } catch (e) {
          console.warn('Erro ao processar mensagem do WebSocket:', e);
        }
      };
    });
